#!/bin/sh
#
# กันของพังตั้งแต่ก่อน commit
#
# ด่านนี้ต้อง **เร็ว** เพราะมันขวางทุกครั้งที่กด commit — ถ้าช้าเกินสิบวินาที
# คนจะเริ่มพิมพ์ --no-verify ทุกครั้งจนด่านนี้ไร้ความหมาย
# จึงเอาแค่ typecheck (3 วินาที) ส่วนเทสต์เต็มไปอยู่ที่ pre-push
#
# ข้ามชั่วคราวได้ด้วย:  git commit --no-verify

set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

# ดูว่าแตะฝั่งไหนบ้าง จะได้ไม่ตรวจฝั่งที่ไม่ได้แก้
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
touched_backend="$(printf '%s\n' "$staged" | grep -c '^backend/' || true)"
touched_frontend="$(printf '%s\n' "$staged" | grep -cv '^backend/' || true)"

fail=0

if [ "$touched_frontend" -gt 0 ]; then
  printf '\033[36m› ตรวจชนิดข้อมูลหน้าบ้าน…\033[0m\n'
  npx tsc --noEmit || fail=1
fi

if [ "$touched_backend" -gt 0 ]; then
  printf '\033[36m› ตรวจชนิดข้อมูลหลังบ้าน…\033[0m\n'
  (cd backend && npx tsc --noEmit) || fail=1
fi

# ไฟล์ที่ไม่ควรหลุดขึ้น repo เด็ดขาด
secrets="$(printf '%s\n' "$staged" | grep -E '(^|/)\.env$|(^|/)\.env\.local$|\.pem$|id_rsa' || true)"

if [ -n "$secrets" ]; then
  printf '\033[31m✗ มีไฟล์ที่ไม่ควรขึ้น repo อยู่ใน staged:\033[0m\n'
  printf '%s\n' "$secrets"
  printf '  เอาออกด้วย: git restore --staged <ไฟล์>\n'
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  printf '\033[31m✗ commit ถูกยกเลิก — แก้ข้างบนก่อน\033[0m\n'
  printf '  (ถ้าจำเป็นจริง ๆ ข้ามได้ด้วย git commit --no-verify)\n'
  exit 1
fi

printf '\033[32m✓ ผ่าน\033[0m\n'
