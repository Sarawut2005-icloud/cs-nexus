// CS Nexus — โครงข้อมูล v2
// กฎที่ยึดทั้งไฟล์นี้ (ดูสเปกสถาปัตยกรรม §7):
//   1. Profile.id = auth.users.id — Supabase Auth เป็นแหล่งความจริงของตัวตน (D1)
//   2. ทุก query แบบ "ของฉัน เรียงใหม่ไปเก่า" ต้องมี composite index ที่ขึ้นต้นด้วยเจ้าของ
//   3. ทุกความสัมพันธ์แบบ "ทำได้ครั้งเดียว" บังคับด้วย composite key ไม่ใช่เช็คในโค้ด
//   4. ตัวนับ (likeCount, viewCount) เก็บไว้ล่วงหน้า — ห้าม COUNT(*) ในฟีด

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL ย้ายไปอยู่ใน prisma7.config.ts และส่ง adapter ให้ PrismaClient
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum ChannelKind {
  DM
  GROUP
  COURSE
  VOICE
}

enum ChannelRole {
  MEMBER
  MODERATOR
}

enum AssetStatus {
  PENDING
  READY
  BLOCKED
}

enum AssetKind {
  IMAGE
  VIDEO
  CODE
  DOCUMENT
  ARCHIVE
}

enum EmbedKind {
  REEL
  POST
}

enum ReportTarget {
  REEL
  POST
  MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum NotificationKind {
  REEL_LIKE
  REEL_COMMENT
  POST_COMMENT
  MENTION
  VOICE_INVITE
}

/// ผูก 1:1 กับ auth.users — FK ข้าม schema และ trigger สร้างแถวอัตโนมัติ
/// อยู่ในไฟล์ migration แบบเขียนมือ (Prisma ไม่ได้จัดการ schema `auth`)
model Profile {
  id                String   @id
  studentId         String   @unique
  studentIdVerified Boolean  @default(false) // ตั้ง true ได้จาก /api/auth/sso เท่านั้น (D2)
  name              String
  role              Role     @default(STUDENT)
  avatarUrl         String?
  storageUsed       BigInt   @default(0) // ไบต์
  storageQuota      BigInt   @default(209715200) // 200 MB
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reels               Reel[]
  posts               Post[]
  postComments        PostComment[]
  messages            Message[]
  memberships         ChannelMember[]
  reelLikes           ReelLike[]
  reelComments        ReelComment[]
  assets              Asset[]
  voiceParticipations VoiceParticipant[]
  notifications       Notification[]
  reportsFiled        Report[]           @relation("ReportReporter")
  reportsResolved     Report[]           @relation("ReportResolver")

  @@index([role])
  @@index([studentIdVerified])
}

model Reel {
  id         String   @id @default(uuid())
  title      String
  caption    String?
  assetId    String   @unique
  durationMs Int // บังคับ <= 60000 ในชั้นแอป เพื่อคุมค่าข้อมูลขาออก
  authorId   String
  likeCount  Int      @default(0)
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())

  asset    Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  author   Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    ReelLike[]
  comments ReelComment[]

  @@index([createdAt(sort: Desc), id]) // cursor ของฟีดหน้าแรก
  @@index([authorId, createdAt(sort: Desc)])
}

model ReelLike {
  reelId    String
  userId    String
  createdAt DateTime @default(now())

  reel Reel    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reelId, userId]) // กดไลก์ซ้ำเป็นไปไม่ได้ตั้งแต่ระดับฐานข้อมูล
  @@index([userId, createdAt(sort: Desc)])
}

model ReelComment {
  id        String   @id @default(uuid())
  reelId    String
  authorId  String
  content   String   @db.VarChar(1000)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  reel   Reel    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reelId, createdAt(sort: Desc)])
}

model Post {
  id           String   @id @default(uuid())
  title        String
  content      String   @db.VarChar(8000)
  courseTag    String?
  authorId     String
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())

  author   Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments PostComment[]

  @@index([createdAt(sort: Desc), id])
  @@index([courseTag, createdAt(sort: Desc)])
}

model PostComment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String    @db.VarChar(4000)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Channel {
  id        String      @id @default(uuid())
  kind      ChannelKind
  name      String? // DM ไม่มีชื่อ
  courseTag String?
  maxSeats  Int         @default(8) // เพดานห้องเสียง — service เป็นคนบังคับ (D7)
  createdAt DateTime    @default(now())

  members       ChannelMember[]
  messages      Message[]
  voiceSessions VoiceSession[]

  @@index([kind, courseTag])
}

model ChannelMember {
  channelId   String
  userId      String
  role        ChannelRole @default(MEMBER)
  lastReadSeq Int         @default(0) // ทำ badge ยังไม่อ่านด้วยการลบเลข ไม่ต้อง COUNT
  joinedAt    DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId]) // "ห้องของฉัน" ต้องเร็ว
}

model Message {
  id          String    @id @default(uuid())
  seq         Int       @default(autoincrement()) // ลำดับจริง — cursor ใช้ตัวนี้ ไม่ใช่ createdAt (D4)
  clientNonce String // กันส่งซ้ำตอนเน็ตกระตุก
  content     String?   @db.VarChar(4000)
  channelId   String
  authorId    String
  editedAt    DateTime?
  deletedAt   DateTime? // ลบแบบทิ้งร่องรอย ไว้ให้ Admin ตรวจ
  createdAt   DateTime  @default(now())

  channel     Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  attachments Asset[]
  embed       MessageEmbed?

  @@unique([channelId, authorId, clientNonce])
  @@index([channelId, seq(sort: Desc)]) // query หลักของแชททั้งระบบ
}

/// รองรับ "In-Chat Reels Share & Preview" — mini player ในช่องแชท
model MessageEmbed {
  messageId String    @id
  kind      EmbedKind
  refId     String // Reel.id หรือ Post.id

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([kind, refId])
}

model Asset {
  id         String      @id @default(uuid())
  ownerId    String
  bucket     String // "reels" | "attachments"
  objectPath String      @unique // {ownerId}/{uuid}.{ext} — ownerId นำหน้าเพื่อเขียน RLS ตาม prefix ได้
  fileName   String
  mimeType   String // ค่าที่ยืนยันจาก magic bytes แล้ว ไม่ใช่ที่ client แจ้ง (D5)
  kind       AssetKind
  sizeBytes  BigInt      @default(0) // ขนาดจริงจาก HEAD หลัง commit
  status     AssetStatus @default(PENDING)
  messageId  String?
  createdAt  DateTime    @default(now())

  owner   Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reel    Reel?

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, createdAt]) // ให้ cron เก็บกวาด PENDING ที่ค้าง
}

model VoiceSession {
  id        String    @id @default(uuid())
  channelId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  channel      Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  participants VoiceParticipant[]

  @@index([channelId, startedAt(sort: Desc)])
}

model VoiceParticipant {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  session VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, joinedAt(sort: Desc)])
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetKind   ReportTarget
  targetId     String
  reason       String       @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  reporter   Profile  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy Profile? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetKind, targetId]) // รายงานเรื่องเดิมซ้ำไม่ได้
  @@index([status, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  refId     String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}
