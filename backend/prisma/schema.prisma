// CS Nexus (aie4-social-reels) — Subsystem Database
// ระบบย่อยภายใต้ CSMJU2030 · standards_version 1.2.0
//
// กฎจาก Blueprint ที่ schema นี้ยึด:
//   1. Database-per-Subsystem — ฐานข้อมูลนี้เป็นของระบบย่อยนี้เท่านั้น
//      ไม่มีตารางไหนที่ระบบย่อยอื่นต้องรู้จัก (หน้า 10)
//   2. Shared Identity คือ `username` เท่านั้น — ห้ามเก็บ user_id หรือ
//      student_id ซ้ำซ้อน ค่าของมันมาจาก header X-User-Id ที่ API Gateway แนบมา
//   3. `layer1_role` (student/alumni/staff/admin) ไม่เก็บลงฐานข้อมูล —
//      อ่านจาก header ทุก request เพราะ Core เป็นแหล่งความจริง
//   4. `layer2_role` เป็น Local Data นิยามเองได้ และเก็บที่นี่
//   5. วันเวลาเป็น timestamptz ทั้งหมด แปลงเป็น ISO 8601 ที่ชั้น API

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL อยู่ใน prisma.config.ts และส่ง adapter ให้ PrismaClient
}

/// Layer 2 — สิทธิ์ระดับระบบย่อย นิยามเองได้ตาม Blueprint หน้า 11
/// default mapping จาก Layer 1: student→GUEST, staff→EDITOR, admin→ADMIN
enum Layer2Role {
  GUEST
  EDITOR
  ADMIN
}

enum ChannelKind {
  DM
  GROUP
  COURSE
  VOICE
}

enum ChannelRole {
  MEMBER
  MODERATOR
}

enum AssetStatus {
  PENDING
  READY
  BLOCKED
}

enum AssetKind {
  IMAGE
  VIDEO
  CODE
  DOCUMENT
  ARCHIVE
}

enum EmbedKind {
  REEL
  POST
}

/// เป้าหมายของอิโมจิรีแอ็กชัน — ครอบทั้งแชท กระดานข่าว และคลิป
enum ReactionTarget {
  MESSAGE
  POST
  REEL
}

/// สิ่งที่บันทึกเก็บไว้ดูทีหลังได้ (ปุ่ม Save แบบ IG / Saved แบบ Facebook)
enum BookmarkTarget {
  POST
  REEL
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ReportTarget {
  REEL
  POST
  MESSAGE
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum NotificationKind {
  REEL_LIKE
  REEL_COMMENT
  POST_COMMENT
  MENTION
  VOICE_INVITE
  FOLLOW
  REACTION
  THREAD_REPLY
  MEETING_INVITE
  CHANNEL_INVITE
}

/// ข้อมูล "เฉพาะระบบย่อยนี้" ของผู้ใช้หนึ่งคน
///
/// ไม่มี name / email / faculty อยู่ที่นี่ตั้งใจ — สามอย่างนั้นเป็นของ Core
/// ถ้าเก็บไว้จะกลายเป็นข้อมูลซ้ำซ้อนที่ล้าสมัยทันทีที่ Core แก้ (หน้า 10)
/// ชื่อที่แสดงบนหน้าจอให้ frontend ขอจาก Core API หรือใช้ ProfileCache
model SubsystemMember {
  username   String     @id // ← Shared Identity จาก X-User-Id
  layer2Role Layer2Role @default(GUEST)

  /// true = ผู้ดูแลตั้งค่านี้ด้วยมือ · false = ค่านี้แปลงมาจาก layer1_role
  ///
  /// จำเป็นเพราะเราไม่เก็บ layer1_role (หน้า 10) แต่ต้องรู้ว่าค่าใน
  /// layer2Role เป็นการตัดสินใจของใคร
  ///
  /// อาการที่ฟิลด์นี้แก้: ผู้ดูแลตั้งโควตาล่วงหน้าให้อาจารย์ก่อนเปิดเทอม
  /// แถวถูกสร้างด้วยค่าเริ่มต้น GUEST แล้วอาจารย์ค้างเป็น GUEST ตลอดกาล
  /// เพราะไม่มีอะไรกลับไปแก้ให้ตรงกับ layer1_role ที่ header บอก
  ///
  /// วิธีทำงาน: ทุกครั้งที่ผู้ใช้ยิง request เรารู้ layer1_role จริงจาก header
  /// ถ้า explicit = false และค่าไม่ตรงกับ default mapping ให้แก้ให้ตรง
  /// (เขียนเฉพาะเมื่อไม่ตรง ไม่ใช่ทุก request)
  layer2RoleExplicit Boolean @default(false)
  storageUsedBytes   BigInt  @default(0)
  storageQuotaBytes  BigInt  @default(209715200) // 200 MB

  /// คำแนะนำตัวที่เขียน "เพื่อชุมชนนี้" — เป็น Local Data ไม่ใช่ของ Core
  ///
  /// เส้นแบ่งที่ยึด: Core เป็นเจ้าของ **ตัวตน** (ชื่อจริง คณะ อีเมล) ส่วน
  /// ข้อความที่ผู้ใช้เขียนแนะนำตัวในระบบย่อยนี้เป็น **เนื้อหา** ที่เขาสร้าง
  /// เหมือนโพสต์หรือคอมเมนต์ จึงเก็บที่นี่ได้
  ///
  /// ห้ามใส่ชื่อจริงหรือรูปโปรไฟล์ลงมาที่นี่เด็ดขาด — สองอย่างนั้นเป็นของ Core
  /// (หน้า 10) ถ้าเก็บซ้ำจะล้าสมัยทันทีที่ Core แก้
  /// TODO(PL): ยืนยันกับ PM ว่า bio กับรูปปกนับเป็น Local Data ตามที่ตีความนี้
  bio String? @db.VarChar(300)

  /// รูปปกของหน้าโปรไฟล์ในระบบย่อยนี้ (ไม่ใช่รูปโปรไฟล์ ซึ่งเป็นของ Core)
  coverAssetId String?  @unique
  cover        Asset?   @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([layer2Role])
  @@map("subsystem_members")
}

/// แคชชื่อที่แสดงผลจาก Core — ไม่ใช่แหล่งความจริง
///
/// มีไว้เพื่อไม่ต้องยิง Core API ทุกครั้งที่เรนเดอร์ฟีด 20 รายการ
/// `syncedAt` บอกว่าข้อมูลเก่าแค่ไหน ถ้าเกิน TTL ให้ดึงใหม่จาก Core
/// TODO(PL): ยืนยันกับ PM ว่าการแคช display_name แบบนี้ผ่านมาตรฐานหน้า 10
model ProfileCache {
  username    String   @id
  displayName String
  avatarUrl   String?
  syncedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@map("profile_cache")
}

model Reel {
  id             String   @id @default(uuid())
  title          String
  caption        String?
  assetId        String   @unique
  durationMs     Int // บังคับ <= 60000 ที่ชั้น DTO เพื่อคุมค่าข้อมูลขาออก
  authorUsername String
  likeCount      Int      @default(0)
  viewCount      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  asset    Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  likes    ReelLike[]
  comments ReelComment[]
  views    ReelView[]

  @@index([createdAt(sort: Desc), id])
  @@index([authorUsername, createdAt(sort: Desc)])
  @@map("reels")
}

model ReelLike {
  reelId    String
  username  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([reelId, username]) // กดไลก์ซ้ำเป็นไปไม่ได้ตั้งแต่ระดับฐานข้อมูล
  @@index([username, createdAt(sort: Desc)])
  @@map("reel_likes")
}

model ReelComment {
  id             String    @id @default(uuid())
  reelId         String
  authorUsername String
  content        String    @db.VarChar(1000)
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId, createdAt(sort: Desc)])
  @@map("reel_comments")
}

model Post {
  id             String   @id @default(uuid())
  title          String
  content        String   @db.VarChar(8000)
  courseTag      String?
  authorUsername String
  commentCount   Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  comments PostComment[]

  @@index([createdAt(sort: Desc), id])
  @@index([courseTag, createdAt(sort: Desc)])
  @@map("posts")
}

model PostComment {
  id             String    @id @default(uuid())
  postId         String
  authorUsername String
  content        String    @db.VarChar(4000)
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}

model Channel {
  id        String      @id @default(uuid())
  kind      ChannelKind
  name      String? // DM ไม่มีชื่อ
  courseTag String?
  maxSeats  Int         @default(8) // เพดานห้องเสียง — บังคับที่ชั้น service
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  members       ChannelMember[]
  messages      Message[]
  voiceSessions VoiceSession[]
  meetings      Meeting[]

  @@index([kind, courseTag])
  @@map("channels")
}

model ChannelMember {
  channelId   String
  username    String
  role        ChannelRole @default(MEMBER)
  lastReadSeq Int         @default(0) // badge ยังไม่อ่าน ทำด้วยการลบเลข ไม่ต้อง COUNT
  joinedAt    DateTime    @default(now()) @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, username])
  @@index([username]) // "ห้องของฉัน" ต้องเร็ว
  @@map("channel_members")
}

model Message {
  id             String  @id @default(uuid())
  seq            Int     @default(autoincrement()) // ลำดับจริงของข้อความ
  clientNonce    String // กันส่งซ้ำตอนเน็ตกระตุก
  content        String? @db.VarChar(4000)
  channelId      String
  authorUsername String

  /// เธรดตอบกลับแบบ Discord/Teams — ข้อความแม่กับลูกอยู่ตารางเดียวกัน
  /// ลูกไม่โผล่ในไทม์ไลน์หลัก แต่ยังกิน seq เดียวกันเพื่อไม่ให้ลำดับเพี้ยน
  parentId   String?
  replyCount Int     @default(0)

  /// ปักหมุด — ห้องหนึ่งมีได้หลายอัน จำกัดจำนวนที่ชั้น service
  pinnedAt         DateTime? @db.Timestamptz(3)
  pinnedByUsername String?

  editedAt  DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3) // ลบแบบทิ้งร่องรอย ไว้ให้ Admin ตรวจ
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  channel     Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attachments Asset[]
  embed       MessageEmbed?
  parent      Message?      @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]     @relation("MessageThread")

  @@unique([channelId, authorUsername, clientNonce])
  @@index([channelId, seq(sort: Desc)]) // query หลักของแชททั้งระบบ
  @@index([parentId, seq]) // อ่านเธรดหนึ่งเส้น — ต้องตรงกับ orderBy: { seq } ที่ใช้จริง
  @@index([channelId, pinnedAt(sort: Desc)]) // รายการปักหมุดของห้อง
  @@map("messages")
}

/// รองรับ "In-Chat Reels Share & Preview" — mini player ในช่องแชท
model MessageEmbed {
  messageId String    @id
  kind      EmbedKind
  refId     String // Reel.id หรือ Post.id

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([kind, refId])
  @@map("message_embeds")
}

model Asset {
  id            String      @id @default(uuid())
  ownerUsername String
  bucket        String // "reels" | "attachments"
  objectPath    String      @unique // {username}/{uuid}.{ext} — username นำหน้าเพื่อคุมสิทธิ์ตาม prefix
  fileName      String
  mimeType      String // ค่าที่ยืนยันจาก magic bytes แล้ว ไม่ใช่ที่ client แจ้ง
  kind          AssetKind
  sizeBytes     BigInt      @default(0) // ขนาดจริงหลัง commit
  status        AssetStatus @default(PENDING)
  messageId     String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  message Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reel    Reel?
  story   Story?
  coverOf SubsystemMember?

  @@index([ownerUsername, createdAt(sort: Desc)])
  @@index([status, createdAt]) // ให้ cron เก็บกวาด PENDING ที่ค้าง
  @@map("assets")
}

model VoiceSession {
  id        String    @id @default(uuid())
  channelId String
  startedAt DateTime  @default(now()) @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)

  channel      Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  participants VoiceParticipant[]

  @@index([channelId, startedAt(sort: Desc)])
  @@map("voice_sessions")
}

model VoiceParticipant {
  id        String    @id @default(uuid())
  sessionId String
  username  String
  joinedAt  DateTime  @default(now()) @db.Timestamptz(3)
  leftAt    DateTime? @db.Timestamptz(3)

  session VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([username, joinedAt(sort: Desc)])
  @@map("voice_participants")
}

model Report {
  id                 String       @id @default(uuid())
  reporterUsername   String
  targetKind         ReportTarget
  targetId           String
  reason             String       @db.VarChar(1000)
  status             ReportStatus @default(OPEN)
  resolvedByUsername String?
  resolvedAt         DateTime?    @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([reporterUsername, targetKind, targetId]) // รายงานเรื่องเดิมซ้ำไม่ได้
  @@index([status, createdAt])
  @@map("reports")
}

model Notification {
  id       String           @id @default(uuid())
  username String // ผู้รับ
  kind     NotificationKind
  refId    String // id ของสิ่งที่ถูกกระทำ ใช้พาไปหน้าที่เกี่ยวข้อง

  /// ใครเป็นคนทำ — ถ้าไม่มีฟิลด์นี้ การแจ้งเตือนจะบอกได้แค่ว่า
  /// "มีคนทำอะไรกับอะไร" แล้วหน้าบ้านต้องยิงถามเพิ่มทีละรายการ
  actorUsername String?

  /// บริบทเพิ่มที่ทำให้แสดงผลได้ในหนึ่ง query เช่น ชื่อห้อง อิโมจิที่กด
  /// ตัวอย่างข้อความ — เป็น snapshot ตอนเกิดเหตุ ไม่ใช่แหล่งความจริง
  payload Json?

  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([username, readAt, createdAt(sort: Desc)]) // เฉพาะตัวกรอง "ยังไม่อ่าน"
  @@index([username, createdAt(sort: Desc)]) // รายการปกติ (ไม่กรอง) ซึ่งเป็นค่าเริ่มต้น
  @@map("notifications")
}

/// Audit log ของระบบย่อย — Blueprint หน้า 3 กำหนดให้ Admin Panel กลางดู Audit Log ได้
model AuditLog {
  id              String   @id @default(uuid())
  actorUsername   String
  actorLayer1Role String
  action          String // เช่น "reel.delete", "member.role_change"
  targetKind      String
  targetId        String
  metadata        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorUsername, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)]) // แผงผู้ดูแลเปิดมาแบบไม่กรอง = เรียงตามเวลาล้วน
  @@map("audit_logs")
}

/// กราฟการติดตาม — รากฐานของฟีด "คนที่ฉันติดตาม"
///
/// เก็บทิศทางเดียว (follower → following) แบบ Instagram ไม่ใช่การเป็นเพื่อน
/// สองทางแบบ Facebook เพราะในบริบทคณะ อาจารย์มีผู้ติดตามหลักร้อย
/// แต่ไม่ควรต้องกดตอบรับทีละคน — ความสัมพันธ์สองทางคำนวณเอาได้
/// ด้วยการเช็คว่ามีทั้งสองแถว (ดู FollowsService.relationWith)
model Follow {
  followerUsername  String // คนกดติดตาม
  followingUsername String // คนถูกติดตาม
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@id([followerUsername, followingUsername])
  @@index([followingUsername, createdAt(sort: Desc)]) // "ใครติดตามฉันบ้าง"
  @@index([followerUsername, createdAt(sort: Desc)]) // "ฉันติดตามใครบ้าง"
  @@map("follows")
}

/// อิโมจิรีแอ็กชัน ใช้ตารางเดียวกับทุกเป้าหมาย
///
/// ไม่แยกตารางต่อชนิด เพราะการนับและการดึง "รีแอ็กชันของฉัน" เขียนครั้งเดียว
/// แล้วใช้ได้ทั้งแชท กระดานข่าว และคลิป — ต้นทุนคือ FK ตรวจไม่ได้ที่ระดับ DB
/// จึงต้องตรวจว่าเป้าหมายมีจริงที่ชั้น service ทุกครั้ง
model Reaction {
  id         String         @id @default(uuid())
  targetKind ReactionTarget
  targetId   String
  username   String
  emoji      String         @db.VarChar(16)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([targetKind, targetId, username, emoji]) // อิโมจิเดิมซ้ำไม่ได้
  @@index([targetKind, targetId]) // นับรวมของโพสต์หนึ่ง
  @@index([username, createdAt(sort: Desc)])
  @@map("reactions")
}

/// รายการที่บันทึกไว้ดูทีหลัง — เห็นได้เฉพาะเจ้าของเท่านั้น
model Bookmark {
  username   String
  targetKind BookmarkTarget
  targetId   String
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@id([username, targetKind, targetId])
  @@index([username, createdAt(sort: Desc)])
  @@map("bookmarks")
}

/// นัดประชุม/นัดติวล่วงหน้าแบบ Microsoft Teams
///
/// ผูกกับห้องเสมอ ไม่ลอยเดี่ยว เพราะสิทธิ์การเห็นนัดยืมมาจากสมาชิกของห้อง
/// พอถึงเวลา ผู้เข้าร่วมกดเข้าห้องเสียงของห้องนั้นได้เลย ไม่ต้องมีลิงก์แยก
model Meeting {
  id                String        @id @default(uuid())
  channelId         String
  title             String        @db.VarChar(200)
  agenda            String?       @db.VarChar(4000)
  startsAt          DateTime      @db.Timestamptz(3)
  endsAt            DateTime      @db.Timestamptz(3)
  status            MeetingStatus @default(SCHEDULED)
  createdByUsername String
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, startsAt])
  @@index([status, startsAt]) // "นัดที่กำลังจะถึง" ของทั้งระบบ
  @@map("meetings")
}

/// ผู้ชมคลิป — นับ "คนที่เคยดู" ไม่ใช่ "จำนวนครั้งที่เล่น"
///
/// เลือกแบบนี้เพราะจำนวนครั้งที่เล่นปั่นได้ด้วยการกดรีเฟรชรัว ๆ แล้วยอดวิว
/// จะกลายเป็นตัวเลขที่ไม่มีความหมาย ส่วนคีย์ (reelId, username) ทำให้
/// คนหนึ่งนับได้ครั้งเดียวตั้งแต่ระดับฐานข้อมูล ไม่ต้องเชื่อ client
///
/// ผลข้างเคียงที่ยอมรับ: ตารางนี้โตตามจำนวน (คลิป × คนดู) ซึ่งใหญ่กว่า
/// ตัวนับเดี่ยว ๆ แต่แลกกับยอดที่เชื่อถือได้และรู้ได้ว่าใครดูคลิปตัวเองบ้าง
model ReelView {
  reelId   String
  username String
  viewedAt DateTime @default(now()) @db.Timestamptz(3)

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([reelId, username])
  @@index([username, viewedAt(sort: Desc)]) // "คลิปที่ฉันดูไปแล้ว"
  @@map("reel_views")
}

/// สตอรี่ 24 ชั่วโมง (Instagram / Facebook)
///
/// **การหมดอายุบังคับตอนอ่าน ไม่ใช่ตอนลบ** — ทุกคิวรีมีเงื่อนไข
/// `expiresAt > now()` ฉะนั้นสตอรี่ที่หมดอายุจะหายจากสายตาผู้ใช้ทันทีที่ถึงเวลา
/// แม้ไม่มีตัวลบมาทำงานเลย
///
/// นี่คือเหตุผลที่ทำได้บนฟรีเทียร์: เดิมผมบอกว่าสตอรี่ต้องมี cron ซึ่งผิด —
/// cron จำเป็นแค่กับการ "คืนพื้นที่เก็บไฟล์" ไม่ใช่กับความถูกต้องของฟีเจอร์
/// ตัวเก็บกวาด (StoriesSweeper) จึงเป็นงานบ้าน ไม่ใช่หัวใจ
model Story {
  id             String  @id @default(uuid())
  authorUsername String
  assetId        String  @unique
  caption        String? @db.VarChar(300)

  /// เก็บเวลาหมดอายุไว้เป็นค่าตายตัว ไม่คำนวณจาก createdAt + 24 ชม. ตอนคิวรี
  /// เพราะถ้าวันหนึ่งเปลี่ยนอายุเป็น 48 ชม. สตอรี่เก่าจะยืดอายุตามย้อนหลัง
  /// ซึ่งไม่ใช่สิ่งที่ผู้โพสต์ตกลงไว้ตอนโพสต์
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  asset Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  views StoryView[]

  @@index([authorUsername, createdAt])
  @@index([expiresAt]) // ให้ตัวเก็บกวาดหาของที่หมดอายุได้เร็ว
  @@map("stories")
}

/// ใครดูสตอรี่ไปแล้ว
///
/// สองหน้าที่: ทำวงแหวน "ยังไม่ดู" รอบรูปโปรไฟล์ และทำรายชื่อผู้ชม
/// ที่เจ้าของสตอรี่เท่านั้นที่เห็น (เหมือน Instagram)
model StoryView {
  storyId  String
  username String
  viewedAt DateTime @default(now()) @db.Timestamptz(3)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([storyId, username])
  @@index([username]) // "สตอรี่ที่ฉันดูไปแล้ว" ตอนคำนวณวงแหวน
  @@map("story_views")
}
