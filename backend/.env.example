# CS Nexus (aie4-social-reels) — Backend
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง · ห้าม commit .env

# ---- Database (Database-per-Subsystem · Blueprint หน้า 10) ----
# dev: docker run -d --name csnexus-pg -e POSTGRES_PASSWORD=postgres \
#        -e POSTGRES_DB=csnexus_social_reels -p 55432:5432 postgres:17-alpine
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/csnexus_social_reels

PORT=4000
NODE_ENV=development

# ---- CSMJU2030 Core ----
# ค่าพวกนี้ได้จากขั้นที่ 3 ของการขึ้นทะเบียน (Blueprint หน้า 6) หลัง PM อนุมัติ
CSMJU_CORE_API_URL=https://api.csmju2030.ac.th
CSMJU_CLIENT_ID=
CSMJU_CLIENT_SECRET=

# ---- Gateway trust ----
# backend ต้องรับ request จาก API Gateway เท่านั้น ห้ามเปิดให้ยิงตรง
# เพราะ header X-User-Id ปลอมได้ถ้าใครยิงเข้ามาได้โดยตรง (Blueprint หน้า 8)
GATEWAY_SHARED_SECRET=

# ---- Dev impersonation ----
# ระหว่างที่ Core ยังไม่พร้อม ให้ปลอม header ของ Gateway เพื่อพัฒนาต่อได้
# ต้องเป็น false ตลอดบน staging และ production — service จะปฏิเสธการบูตถ้าเป็น true
DEV_FAKE_GATEWAY=true
DEV_FAKE_USERNAME=6704101382-anuchat
DEV_FAKE_LAYER1_ROLE=student
DEV_FAKE_FACULTY=science

# ---- Object storage (ไฟล์แนบ / วิดีโอ) ----
# ใช้ Supabase Storage เฉพาะการเก็บไฟล์ ไม่ได้ใช้ Supabase Auth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WebRTC (ห้องเสียง + แชร์หน้าจอ) ----
#
# STUN ใช้ฟรี ไม่ต้องตั้งอะไร — ระบบใส่ของ Google กับ Cloudflare ไว้ให้แล้ว
# สี่ตัว (ดู voice.service.ts) ครอบคลุมผู้ใช้ส่วนใหญ่
#
# TURN จำเป็นเฉพาะกับคนที่อยู่หลัง NAT แบบเจาะไม่ได้ หรือเน็ตที่บล็อก UDP
# ขาออก — พบบ่อยในเน็ตมหาลัยและหอพัก ถ้าไม่มี คนกลุ่มนั้นจะโทรไม่ติดเลย
#
# **ให้ผู้ใช้กดปุ่ม "ตรวจว่าเครือข่ายนี้โทรได้ไหม" ในหน้าห้องเสียงก่อน**
# ถ้าผลออกมาว่าโทรได้ ก็ยังไม่ต้องตั้ง TURN
#
# ตั้ง TURN แบบไม่เสียเงิน เลือกทางใดทางหนึ่ง:
#
#   1. รัน coturn เองบนเครื่องที่มีอยู่แล้ว (เครื่องแล็บ เซิร์ฟเวอร์คณะ
#      หรือแม้แต่โน้ตบุ๊กตอนเดโม) — ฟรีสนิท ข้อแลกคือเครื่องต้องเปิดค้าง
#      และต้องเปิดพอร์ตให้เข้าถึงได้จากเน็ตที่ผู้ใช้อยู่
#        docker run -d --network host coturn/coturn \
#          -n --realm=cs-nexus --user=csnexus:เปลี่ยนรหัสนี้ \
#          --listening-port=3478 --fingerprint --lt-cred-mech
#      แล้วตั้ง TURN_URL=turn:<ไอพีเครื่องนั้น>:3478
#
#   2. ผู้ให้บริการที่มีชั้นใช้ฟรี (ต้องสมัครบัญชี แต่ไม่ต้องผูกบัตรก็มี)
#      — วางค่าที่เขาให้มาลงสามบรรทัดข้างล่างได้เลย
#
#   3. VPS ชั้นฟรีถาวร แล้วลง coturn ตามข้อ 1
#
# เรื่องความเป็นส่วนตัวที่ควรรู้: เสียงที่วิ่งผ่าน TURN ยังถูกเข้ารหัสแบบ
# ปลายทางถึงปลายทางด้วย DTLS-SRTP เจ้าของ TURN จึงเห็นแค่ว่ามีทราฟฟิกวิ่งผ่าน
# **ฟังเนื้อเสียงไม่ได้** การใช้ TURN ของคนอื่นจึงยอมรับได้ในแง่ความลับ
#
# ใส่หลาย URL ได้ คั่นด้วยลูกน้ำ (เช่น ใส่ทั้ง UDP และ TCP/443 เผื่อโดนบล็อก)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- CORS ----
# โดเมนของหน้าบ้าน คั่นด้วยลูกน้ำ เว้นว่างในโหมด dev
CORS_ORIGIN=
