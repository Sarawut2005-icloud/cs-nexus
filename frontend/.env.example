# ─────────────────────────────────────────────────────────────────────
# หน้าบ้าน — ตัวอย่างค่า environment
#
# คัดลอกเป็น .env.local แล้วแก้ค่าให้ตรงเครื่องตัวเอง (.env.local ถูก gitignore)
#
# **ทุกค่าที่ขึ้นต้นด้วย NEXT_PUBLIC_ ถูกฝังลงไฟล์ JavaScript ที่ส่งให้เบราว์เซอร์**
# ใครก็เปิดดูได้ ห้ามใส่ความลับใด ๆ ตรงนี้เด็ดขาด (ui-design-system.md ข้อ 16.1.1)
# ─────────────────────────────────────────────────────────────────────

# หลังบ้านของเราเอง
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── ทางเข้าระบบ ─────────────────────────────────────────────────────
#
# **ไม่ใช่หน้า login ของ Core Hub โดยตรง** แต่เป็น SSO launcher ของมัน
# ยืนยันจากโค้ดจริงของ csmju-core-hub เมื่อ 27 ก.ย. 2569:
# `frontend/app/api/sso/[subsystem]/route.ts`
#
#   ยังไม่ได้ล็อกอิน → เด้งไป /login?next=/api/sso/csmju-social-reels
#   ล็อกอินแล้ว      → ขอ handoff จาก Core API แล้วเด้งกลับมาที่
#                      callback_url ที่ Subsystem Registry ถือไว้
#
# URL เดียวจึงใช้ได้ทั้งสองกรณี ไม่ต้องแยกปุ่ม
# ชื่อท้าย path ต้องตรงกับ `name` ใน subsystem.yaml เป๊ะ
NEXT_PUBLIC_CORE_LOGIN_URL=http://127.0.0.1:3100/api/sso/csmju-social-reels

# Core Hub ยังไม่มีหน้าสมัครสมาชิกแยก (บัญชีมาจากทะเบียนของมหาวิทยาลัย)
# ปล่อยว่างไว้ ปุ่ม "สมัคร" จะถูกปิดพร้อมคำอธิบาย แทนที่จะพาไปหน้าตาย
NEXT_PUBLIC_CORE_SIGNUP_URL=

# ─── พอร์ตที่ใช้กันในเครื่องพัฒนา ────────────────────────────────────
#
#   3000  Core Hub API        (csmju-core-hub/backend — ตรึงไว้ในโค้ดเขา)
#   3100  Core Hub UI         (csmju-core-hub/frontend)
#   4000  หลังบ้านของเรา
#   4100  หน้าบ้านของเรา        ← ต้องไม่ใช่ 3000 ไม่งั้นชนกับ Core Hub API
#  55432  PostgreSQL
